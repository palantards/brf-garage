# Copy this file to .env.local and fill in the values.
# cp env.example .env.local

# Neon PostgreSQL connection string
# Get from: https://console.neon.tech
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Auth.js secret — generate with: openssl rand -base64 32
AUTH_SECRET=

# The URL of your app (no trailing slash)
AUTH_URL=http://localhost:3000

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=re_...

# From-email for Resend (must be from a verified domain)
RESEND_FROM=noreply@yourdomain.com

# Vercel Blob read/write token
# Create a Blob store in Vercel Dashboard → Storage → Blob, then copy the token
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Email address that receives notifications when a new floor plan is uploaded
# Ops will run: npx tsx scripts/process-map.ts <assocId>
OPS_EMAIL=ops@yourdomain.com
